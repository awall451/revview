#!/bin/bash
# tools/long-drive [options]: the long-run replay (a simulated 4 hours of recorded sessions against the real server and
# page, with restarts and drops). Run on request; tools/check never runs it. Options and method: docs/LONG-DRIVE.md.
set -uo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || exit 2
cd "$root" || exit 2
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-/opt/ms-playwright}"
[ -d node_modules ] || npm ci --no-audit --no-fund --loglevel=error || exit 2
exec node tests/long/drive.js "$@"
