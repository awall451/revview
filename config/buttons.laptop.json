    { "key": "Space", "button": "push-to-talk" },
    { "key": "R", "button": "read-aloud", "hold": true },
    { "key": "Esc", "button": "cancel", "longHold": true },
    { "key": "N", "button": "deny" },
    { "key": "M", "button": "menu", "hold": true }
