# System unit template: pi/data-setup.sh renders @REVVIEW_DIR@ and installs it as
# /etc/systemd/system/revview-unlock.service. From memory, UNTESTED on a Pi.
# Unlocks the data partition with the key stick (pi/unlock.sh). Not RemainAfterExit: the udev rule
# 72-revview-key.rules starts it again when the stick is plugged in later (a finished oneshot can be restarted).
[Unit]
Description=revview: unlock the data partition with the key stick
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/bash @REVVIEW_DIR@/pi/unlock.sh

[Install]
WantedBy=multi-user.target
