# systemd USER unit for the revview server on the Pi. UNTESTED: written without a Pi.
# pi/install.sh (via pi/setup.mjs) renders it to /etc/systemd/user/revview.service with @REVVIEW_DIR@, @NODE@
# and @USER@ replaced, and enables it with a symlink in /etc/systemd/user/default.target.wants/. Lingering is
# on for that user, so the unit starts at boot in the user's manager (with XDG_RUNTIME_DIR: PipeWire audio and
# the microphone work for Claude's /voice and for read aloud). The user's Claude sign-in and hooks live there too.
#
# ConditionUser: /etc/systemd/user is read by every user's manager; only the kiosk user runs it.
# No User= and no SupplementaryGroups= (not allowed in user units): the user is in groups input and audio.
#
# Flags: --input (the wheel-button reader runs inside the server; its file is /etc/revview/buttons.json, the owner's
# copy of config/buttons.json, written once by install.sh and never overwritten), --sessions (revview's own tmux sessions),
# --boot (STARTING at key-on, then the REVVIEW_START session), --netmon (RevviewNetwork events) and --thermal (HOT / LOW POWER
# marks from vcgencmd get_throttled and the CPU temperature; quiet when they cannot be read; from memory, untested).
# NEVER add --dev-bridge: it opens POST /dev/key and is for the emulator only.
#
# Ordering: there is deliberately no Requires=, Wants= or After= on the kiosk, the network or the dongle.
# The kiosk (labwc autostart, pi/kiosk.sh) is not a unit; it shows NO LINK until the server answers (bench 22).
# The reader looks for the dongle every second and backs off when it is absent (src/input/reader.js), so a
# missing dongle at boot fails and delays nothing.
[Unit]
Description=revview server (view, wheel-button reader, sessions)
ConditionUser=@USER@

[Service]
Type=simple
WorkingDirectory=@REVVIEW_DIR@
Environment=REVVIEW_PORT=8138
# Claude Code's native install puts `claude` in ~/.local/bin; the tmux sessions inherit this PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Optional: REVVIEW_PROJECTS, REVVIEW_START, REVVIEW_NETMON_HOST (see /etc/revview/server.env)
EnvironmentFile=-/etc/revview/server.env
# Written by pi/data-setup.sh only: sets REVVIEW_DATA_MOUNT (the server keeps the key-on session until the data is
# unlocked and shows INSERT KEY) and CLAUDE_CONFIG_DIR.
EnvironmentFile=-/etc/revview/data.env
# Under the read-only root an update would land in RAM and vanish. Claude Code is updated with the overlay off
# (pi/README.md, Updating). The variable name is in Claude Code 2.1.330; its effect is from memory.
Environment=DISABLE_AUTOUPDATER=1
ExecStart=@NODE@ @REVVIEW_DIR@/src/server/index.js --input /etc/revview/buttons.json --sessions --boot --netmon --thermal
Restart=always
RestartSec=2
# Do not kill the private tmux server (revview's sessions) when the service restarts: only the node
# process is stopped. grab.py exits by itself when its parent is gone (bench W5). Untested (bench D3).
KillMode=process
NoNewPrivileges=yes

[Install]
WantedBy=default.target
