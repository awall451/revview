{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/permission-request.mjs\" # revview-hook", "timeout": 600 }]
      }
    ],
    "PermissionDenied": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$REVVIEW_DIR/hooks/event.mjs\" # revview-hook", "timeout": 5 }] }]
  }
}
